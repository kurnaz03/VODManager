# Application
APP_NAME=VOD Manager
DEBUG=false
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://YOUR_SERVER_IP,http://YOUR_SERVER_IP:80

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://vod_user:CHANGE_ME_DB_PASSWORD@localhost:5432/vod_manager
SYNC_DATABASE_URL=postgresql+psycopg2://vod_user:CHANGE_ME_DB_PASSWORD@localhost:5432/vod_manager

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SETUP=3/minute

# Fernet encryption key (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=CHANGE_ME_generate_fernet_key

# Shared storage root (HLS segments, uploads, transcode output)
SHARED_STORAGE_ROOT=/var/www/vod-manager/shared

# Main / managed server info
MAIN_SERVER_NAME=Main Server
MAIN_SERVER_IP=YOUR_SERVER_IP
MAIN_SERVER_SSH_PORT=22
MAIN_SERVER_SSH_USERNAME=root
MAIN_SERVER_SSH_PASSWORD=CHANGE_ME_SSH_PASSWORD

# Playwright (for stream checking)
PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright
